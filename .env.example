# ==============================================================================
# ÖTZI — Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or expose private keys to source control.
# ==============================================================================

# Supabase (Database, Auth, RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# Cloudinary (Media Storage & Delivery - Free Tier)
# Cloud Name: jdn58nxv
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=jdn58nxv
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret-server-only
